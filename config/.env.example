# Copy to config/.env and fill in. config/.env is gitignored - keep it that way.
# Run `just preflight` (or scripts/preflight.py) to check these are live.

# --- Models -------------------------------------------------------------
# OpenAI: needed for the Realtime API (speech-to-speech). This is the default
# path. https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Anthropic: used for the cascade path's reasoning, and for offline scenario
# generation. NOTE: a Claude Code subscription does NOT include an API key -
# this is billed separately. https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# REALTIME=1 uses OpenAI speech-to-speech (lower latency, more human).
# REALTIME=0 uses the Deepgram -> LLM -> ElevenLabs cascade.
REALTIME=1
REALTIME_MODEL=gpt-realtime
REALTIME_VOICE=marin
LLM_MODEL=gpt-4.1

# --- Telephony ----------------------------------------------------------
# livekit | a1mobile | twilio
TELEPHONY_PROVIDER=livekit

# LiveKit Cloud (free tier is enough). `lk cloud auth` writes these for you.
# https://cloud.livekit.io
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Created by: lk sip outbound create config/sip-outbound-trunk.json
LIVEKIT_SIP_TRUNK_ID=

# a1mobile - fill in from the kickoff starter kit.
A1MOBILE_API_KEY=
A1MOBILE_BASE_URL=
A1MOBILE_FROM_NUMBER=

# Twilio - fallback rails only. ~$1.15/mo for a number.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_TWIML_URL=

# --- Optional voice vendors --------------------------------------------
# Only needed when REALTIME=0.
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
CARTESIA_API_KEY=

# --- Verification -------------------------------------------------------
# The number confirmations should be sent TO. This is what makes a claim
# verifiable - if it is unset, nothing can ever be independently confirmed.
CALLBACK_NUMBER=

# Public URL of the webhook listener (ngrok http 8080).
WEBHOOK_BASE_URL=

# --- Errand -------------------------------------------------------------
ERRAND_TASK=
ERRAND_CONSTRAINTS=
